# =============================================================================
# The Doctor Index — environment variables
# =============================================================================
#
# Copy to .env.local for development. Never commit a filled-in copy.
#
#   cp .env.example .env.local
#
# Every variable is grouped by the service it belongs to and tagged:
#
#   [READ]      This repository reads it today. Parsed in lib/env.ts (server and
#               build), components/RouteInspector.tsx (client) or next.config.ts.
#   [RESERVED]  Named for the service the plan specifies (§13 architecture,
#               §16 compliance, §17 analytics) so every environment is provisioned
#               against one list. Nothing in this repository reads it yet.
#
# Rules
#   - NEXT_PUBLIC_* values are inlined into the browser bundle. Never a secret.
#   - Values are read at build time for static routes. Changing a gate or a
#     ranking weight needs a rebuild to take effect on prerendered pages.
#   - Empty value = use the default shown in lib/env.ts (READ) or unset (RESERVED).
#   - Booleans accept 1/0 or true/false.
#
# Sections
#   1. Site and runtime          9. Maps and geocoding
#   2. Launch cluster           10. Media and object storage
#   3. Indexation gates         11. Verification sources
#   4. Ranking weights          12. Security, bot defence, encryption
#   5. Freshness windows        13. Analytics, monitoring, logging
#   6. Feature flags            14. SEO tooling
#   7. Directory API, database 15. Notifications and alerts
#   8. Auth, OTP, messaging    16. Compliance, retention, legal versions
#                              17. Moderation and SLA targets
#                              18. Payments and integrations (Phase 6)
#                              19. Admin console
#                              20. Cache, CDN, ISR
#                              21. Jobs and scheduling
#                              22. Local development, testing, CI
#

# =============================================================================
# 1. Site and runtime
# =============================================================================

# [READ] Absolute origin, no trailing slash. Canonicals, sitemaps, robots.txt,
# JSON-LD and the sitemap index are all built from this. Set per environment
# or a preview will declare production URLs.
NEXT_PUBLIC_SITE_URL=https://thedoctorindex.in

# [READ] Brand name as shown in titles, header, footer and Organization schema.
NEXT_PUBLIC_SITE_NAME=The Doctor Index

# [READ] Published grievance contact (DPDP + IT Rules). Footer, About, privacy
# and grievance pages, Organization JSON-LD contactPoint.
NEXT_PUBLIC_GRIEVANCE_EMAIL=grievance@thedoctorindex.in

# [READ] General support contact.
NEXT_PUBLIC_SUPPORT_EMAIL=support@thedoctorindex.in

# [READ] Emergency number shown in the footer notice and health guides.
NEXT_PUBLIC_EMERGENCY_NUMBER=108

# [READ] development | staging | production. Shown nowhere; used by lib/env.ts
# for environment-specific defaults.
APP_ENV=development

# [READ] Set to 1 on staging and every preview. Middleware adds
# "X-Robots-Tag: noindex, nofollow" to every response — HTML, sitemaps,
# robots.txt — regardless of page-level gates. Never set in production.
FORCE_NOINDEX=

# [READ] Set to 1 to show the route inspector on a production build without
# ?inspect=1. Useful on staging for SEO review. Leave unset in production.
NEXT_PUBLIC_ROUTE_INSPECTOR=

# [READ] Origin of the media CDN. Registered as the only allowed remote image
# host in next.config.ts (next/image remotePatterns). Must be a valid URL.
NEXT_PUBLIC_MEDIA_CDN_URL=

# Node and Next runtime.
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
# Set to 1 to opt out of Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1
# Set to true to run @next/bundle-analyzer on build (RESERVED until the plugin is added).
ANALYZE=

# =============================================================================
# 2. Launch cluster and locale
# =============================================================================

# [READ] Defaults for search, breadcrumbs and the browse hierarchy.
NEXT_PUBLIC_DEFAULT_COUNTRY=IN
NEXT_PUBLIC_DEFAULT_STATE_SLUG=karnataka
NEXT_PUBLIC_DEFAULT_CITY_SLUG=bengaluru
NEXT_PUBLIC_LOCALE=en-IN
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_CURRENCY=INR

# [RESERVED] Phase 6 multilingual pages. Comma-separated BCP 47 tags.
NEXT_PUBLIC_SUPPORTED_LOCALES=en-IN
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN

# =============================================================================
# 3. Indexation gates  (plan §6; lib/seo/gates.ts)
# =============================================================================
# Operating defaults, not Google requirements. Every route's robots meta, the
# sitemaps and the route inspector read the same values, so they cannot drift.

# [READ] Minimum quality score (0–100) for a doctor profile to be indexed.
GATE_PROFILE_QUALITY=70
# [READ] Minimum indexable doctors before a city × speciality page is indexed.
GATE_CITY_SPECIALTY_MIN_DOCTORS=3
# [READ] Minimum indexable doctors before a locality × speciality page is indexed.
GATE_LOCALITY_SPECIALTY_MIN_DOCTORS=5
# [READ] Minimum indexable doctors before a national speciality hub is indexed.
GATE_NATIONAL_SPECIALTY_MIN_DOCTORS=3
# [READ] Localities with at least this many indexable doctors get a crawlable
# link from the city page. Below it, the page exists but nothing links in.
GATE_LOCALITY_LINK_MIN_DOCTORS=2

# =============================================================================
# 4. Ranking weights  (plan §8.3; lib/ranking.ts; published at /policies/ranking)
# =============================================================================
# Must sum to 100. There is deliberately no weight for payment.

# [READ]
RANK_WEIGHT_RELEVANCE=35
RANK_WEIGHT_LOCATION=20
RANK_WEIGHT_VERIFICATION=15
RANK_WEIGHT_COMPLETENESS=10
RANK_WEIGHT_FRESHNESS=10
RANK_WEIGHT_REVIEW_CONFIDENCE=10
# [READ] Review count at which the minimum-confidence discount reaches full weight.
RANK_REVIEW_CONFIDENCE_FULL_AT=25
# [RESERVED] Diversity: max results from one facility group on a first page.
RANK_DIVERSITY_MAX_PER_FACILITY=3

# =============================================================================
# 5. Freshness and reverification windows  (plan §9.5)
# =============================================================================

# [READ] Days after which a fee is hidden and excluded from the fee filter.
FRESHNESS_FEE_DAYS=90
# [READ] Days after which a practice address/contact prompts reconfirmation.
FRESHNESS_PRACTICE_DAYS=180
# [READ] Days between registration and disciplinary re-checks.
FRESHNESS_REGISTRATION_DAYS=365
# [READ] Days without reconfirmation after which a profile leaves the index.
FRESHNESS_DEINDEX_AFTER_DAYS=365
# [RESERVED] Days before a due date to start prompting the doctor.
FRESHNESS_PROMPT_LEAD_DAYS=21

# =============================================================================
# 6. Feature flags
# =============================================================================

# [READ] Optional map view on listings (needs a maps browser key; see §9).
NEXT_PUBLIC_FEATURE_MAP_VIEW=0
# [READ] Accept new reviews. Set 0 before counsel signs off the review policy.
NEXT_PUBLIC_FEATURE_REVIEWS_OPEN=1
# [READ] Appointment enquiry form on profiles.
NEXT_PUBLIC_FEATURE_ENQUIRIES=1
# [READ] WhatsApp contact action where the practice has consented.
NEXT_PUBLIC_FEATURE_WHATSAPP=0
# [READ] Clinic/hospital pages (Phase 2).
NEXT_PUBLIC_FEATURE_CLINIC_PAGES=0
# [READ] Labelled sponsored cards outside organic results (Phase 6).
NEXT_PUBLIC_FEATURE_SPONSORED=0
# [READ] Doctor dashboard reachable.
NEXT_PUBLIC_FEATURE_DOCTOR_DASHBOARD=1
# [RESERVED] Appointment booking integrations (Phase 6).
NEXT_PUBLIC_FEATURE_BOOKING=0
# [RESERVED] Additional practitioner systems (dentists, AYUSH, allied health).
NEXT_PUBLIC_FEATURE_PRACTITIONER_SYSTEMS=modern-medicine

# =============================================================================
# 7. Directory API, database, cache, queue
# =============================================================================

# --- Directory API [RESERVED] — replaces the seed in lib/data/doctors.ts -----
# Base URL of the NestJS API. Server-side only.
DIRECTORY_API_URL=http://localhost:4000
# Service-to-service bearer token for server components and route handlers.
DIRECTORY_API_TOKEN=
# Request timeout for API calls from the web tier.
DIRECTORY_API_TIMEOUT_MS=5000
# Shared secret the API presents when calling /api/revalidate after an approved edit.
REVALIDATE_SECRET=
# OpenAPI document URL for client generation.
DIRECTORY_API_OPENAPI_URL=http://localhost:4000/openapi.json

# --- PostgreSQL [READ] — Drizzle + postgres.js; PostGIS + pg_trgm optional ----
# Application connection (pooled). Use ?sslmode=require outside local dev.
DATABASE_URL=postgresql://tdi_app:password@localhost:5432/thedoctorindex
# Direct (non-pooled) connection for migrations (drizzle.config.ts prefers it).
DIRECT_URL=postgresql://tdi_migrate:password@localhost:5432/thedoctorindex
# [READ] TLS: require (default; Neon, Supabase, RDS) | disable (local Postgres).
DATABASE_SSL=require
# [READ] postgres.js pool size and idle timeout for the web tier.
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=20000
# [READ] db | seed. Defaults to db when DATABASE_URL is set, else seed (the
# 24 fictional doctors in lib/data/doctors.ts). Seed mode builds without a DB.
DATA_SOURCE=
# [READ] Must be 1 for `npm run db:reset` (drops the public schema). Never in production.
DATABASE_ALLOW_DESTRUCTIVE_MIGRATIONS=0
# Read replica for listing and search reads, if provisioned.
DATABASE_READ_URL=
# Shadow database for migration diffing (Prisma).
SHADOW_DATABASE_URL=
DATABASE_SSL=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_IDLE_TIMEOUT_MS=30000
# Schema for application tables.
DATABASE_SCHEMA=public
# Spatial reference for practice coordinates (WGS 84).
DATABASE_POSTGIS_SRID=4326
# Backups: bucket for logical dumps; point-in-time recovery window.
DATABASE_BACKUP_BUCKET=
DATABASE_PITR_RETENTION_DAYS=14
# Set to 1 to allow destructive migrations (never in production).
DATABASE_ALLOW_DESTRUCTIVE_MIGRATIONS=0

# --- Supabase [RESERVED] — only if Supabase is chosen as the managed Postgres --
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- Redis [RESERVED] — cache and rate limits -------------------------------
REDIS_URL=redis://localhost:6379
REDIS_TLS=0
# Prefix so several environments can share one Redis in staging.
REDIS_KEY_PREFIX=tdi:
# Default TTL for cached listing fragments and rating rollups.
REDIS_DEFAULT_TTL_SECONDS=300

# --- Queue and outbox worker [RESERVED] -------------------------------------
# Provider: sqs | pubsub | rabbitmq | bullmq
QUEUE_PROVIDER=bullmq
QUEUE_URL=
QUEUE_DEAD_LETTER_URL=
QUEUE_NAME_OUTBOX=tdi-outbox
QUEUE_NAME_MEDIA=tdi-media
QUEUE_NAME_NOTIFICATIONS=tdi-notifications
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000
# Outbox polling interval for the worker.
OUTBOX_POLL_INTERVAL_MS=1000

# --- Search [RESERVED] — Typesense or Algolia; disposable read model ----------
SEARCH_PROVIDER=typesense
# Typesense
TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_ADMIN_API_KEY=
# Search-only key is safe to expose to the browser.
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY=
# Algolia (alternative)
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
# Index names. Only public fields are ever indexed.
SEARCH_INDEX_DOCTORS=doctors
SEARCH_INDEX_PRACTICES=practices
SEARCH_INDEX_TAXONOMY=taxonomy
# Approved-change → search freshness target (plan §13.3: ≤ 60 s).
SEARCH_REINDEX_SLA_SECONDS=60
# Geo search defaults.
SEARCH_DEFAULT_RADIUS_KM=5
SEARCH_MAX_RADIUS_KM=25

# =============================================================================
# 8. Authentication, OTP, SMS, email, WhatsApp
# =============================================================================

# --- Sessions [READ] — passwordless OTP for patients, doctors and staff --------
# 32+ random bytes, base64 (`openssl rand -base64 48`). Required in production;
# signs the session cookie (HS256). Changing it signs everyone out.
AUTH_SECRET=
AUTH_URL=https://thedoctorindex.in
AUTH_COOKIE_NAME=tdi_session
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=1
AUTH_SESSION_TTL_SECONDS=2592000
# Comma-separated hosts allowed to complete sign-in (prevents host-header attacks).
AUTH_TRUSTED_HOSTS=thedoctorindex.in,www.thedoctorindex.in

# --- OTP policy [READ] -------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# Daily OTP cap per contact and per IP.
OTP_DAILY_LIMIT_PER_CONTACT=10
OTP_DAILY_LIMIT_PER_IP=50

# --- Staff identity — bootstrap admin is [READ]; MFA/OIDC are [RESERVED] --------
# [READ] Require an authenticator app (TOTP) for every staff account before the
# console opens. Defaults to 1 in production, 0 elsewhere. An enrolled staff
# member is always asked for a code once per session regardless.
STAFF_MFA_REQUIRED=1
# Provider: totp (built in) | webauthn | oidc (reserved)
STAFF_MFA_PROVIDER=totp
# OIDC (e.g. Google Workspace) for staff SSO.
STAFF_OIDC_ISSUER=
STAFF_OIDC_CLIENT_ID=
STAFF_OIDC_CLIENT_SECRET=
# Only these email domains may hold staff roles.
STAFF_ALLOWED_EMAIL_DOMAINS=thedoctorindex.in
# Initial super administrator (bootstrapped once, then managed in the console).
STAFF_BOOTSTRAP_ADMIN_EMAIL=

# --- SMS [READ] — provider: console | twilio (msg91 | kaleyra | sns reserved) ---
SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_SENDER_ID=
# DLT registration is mandatory for transactional SMS in India.
SMS_DLT_ENTITY_ID=
SMS_DLT_TEMPLATE_ID_OTP=
SMS_DLT_TEMPLATE_ID_RECONFIRM=
SMS_DLT_TEMPLATE_ID_VERIFIED=
SMS_DLT_TEMPLATE_ID_ENQUIRY=
# Twilio (alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Kaleyra (alternative)
KALEYRA_API_KEY=
KALEYRA_SID=
# AWS SNS (alternative) — uses STORAGE_* credentials unless set here.
SNS_REGION=ap-south-1

# --- Email [READ] — provider: console | resend | postmark (ses | sendgrid | smtp reserved)
EMAIL_PROVIDER=console
# Resend / Postmark credentials (whichever EMAIL_PROVIDER names).
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@thedoctorindex.in
EMAIL_FROM_NAME=The Doctor Index
EMAIL_REPLY_TO=support@thedoctorindex.in
# SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=0
# Amazon SES
SES_REGION=ap-south-1
SES_CONFIGURATION_SET=
# Postmark / SendGrid / Resend
POSTMARK_SERVER_TOKEN=
SENDGRID_API_KEY=
RESEND_API_KEY=
# Template IDs (provider-side templates) per message type.
EMAIL_TEMPLATE_OTP=
EMAIL_TEMPLATE_VERIFICATION_OUTCOME=
EMAIL_TEMPLATE_RECONFIRM=
EMAIL_TEMPLATE_REVIEW_PUBLISHED=
EMAIL_TEMPLATE_REVIEW_REPLY=
EMAIL_TEMPLATE_ENQUIRY_TO_PRACTICE=
EMAIL_TEMPLATE_GRIEVANCE_ACK=
# Internal inboxes where public forms are routed.
EMAIL_GRIEVANCE_INBOX=grievance@thedoctorindex.in
EMAIL_VERIFICATION_INBOX=verification@thedoctorindex.in
EMAIL_MODERATION_INBOX=moderation@thedoctorindex.in
EMAIL_CORRECTIONS_INBOX=corrections@thedoctorindex.in
EMAIL_LEGAL_ESCALATION_INBOX=legal@thedoctorindex.in
# Inbound email (reply-to-thread) webhook secret, if used.
EMAIL_INBOUND_WEBHOOK_SECRET=

# --- WhatsApp [RESERVED] — only where the practice has consented -------------
# Provider: meta-cloud | twilio | gupshup | interakt
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_ENQUIRY=

# =============================================================================
# 9. Maps and geocoding  (geocoding [READ] by scripts/geocode.ts; maps [RESERVED])
# =============================================================================

# Provider: google | mapbox | mapmyindia | ola
MAPS_PROVIDER=google
# [READ] Geocoder for `npm run db:geocode`: nominatim (OpenStreetMap, no key,
# 1 req/s, needs a contact email) | google (needs GEOCODING_API_KEY). Writes
# facility lat/lng with source + confidence; staff can override in the console.
GEOCODING_PROVIDER=nominatim
GEOCODING_CONTACT_EMAIL=
GEOCODING_API_KEY=
GEOCODING_REGION_BIAS=in
GEOCODING_MIN_CONFIDENCE=0.7
# Browser key for the optional map view; restrict by HTTP referrer.
NEXT_PUBLIC_MAPS_BROWSER_KEY=
NEXT_PUBLIC_MAPS_STYLE_ID=
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=13
# Mapbox (alternative)
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=
# MapmyIndia / Ola Maps (alternative)
MAPMYINDIA_CLIENT_ID=
MAPMYINDIA_CLIENT_SECRET=
OLA_MAPS_API_KEY=
# Directions deep link base for the "Directions" action.
NEXT_PUBLIC_DIRECTIONS_URL_BASE=https://www.google.com/maps/dir/?api=1&destination=
# Static map tiles cache TTL.
MAPS_TILE_CACHE_SECONDS=86400

# =============================================================================
# 10. Media and object storage  [RESERVED]
# =============================================================================
# Private originals; approved AVIF/WebP/JPEG derivatives only via CDN (plan §13.1).

# Provider: s3 | r2 | gcs | azure | minio
STORAGE_PROVIDER=s3
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Custom endpoint for R2 / MinIO / GCS interoperability.
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=0
# Private bucket: identity documents, review evidence, original uploads. Never public.
STORAGE_BUCKET_PRIVATE=tdi-private
# Public bucket: approved derivatives only.
STORAGE_BUCKET_PUBLIC=tdi-public
# Quarantine bucket: uploads before scanning.
STORAGE_BUCKET_QUARANTINE=tdi-quarantine
# Server-side encryption for private objects: AES256 | aws:kms
STORAGE_PRIVATE_SSE=aws:kms
STORAGE_KMS_KEY_ID=
# Signed URL lifetime for staff access to private evidence.
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Object lock / retention on the private bucket (days).
STORAGE_PRIVATE_RETENTION_DAYS=1095

# --- Uploads ---------------------------------------------------------------
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_MIME_IMAGES=image/jpeg,image/png,image/webp,image/heic
UPLOAD_ALLOWED_MIME_DOCUMENTS=application/pdf,image/jpeg,image/png
UPLOAD_MAX_IMAGE_DIMENSION=4096
# Strip EXIF and other metadata from every image on ingest.
UPLOAD_STRIP_METADATA=1
# Malware scanning: clamav | cloud-scan | none (never none outside local dev)
UPLOAD_SCANNER=clamav
UPLOAD_SCANNER_URL=tcp://clamav:3310
UPLOAD_SCANNER_TIMEOUT_MS=20000

# --- Image derivatives -----------------------------------------------------
# Derivative sizes generated for doctor photographs (px, comma-separated).
MEDIA_AVATAR_SIZES=64,128,256,512
MEDIA_FORMATS=avif,webp,jpeg
MEDIA_AVIF_QUALITY=55
MEDIA_WEBP_QUALITY=78
MEDIA_JPEG_QUALITY=82
# Image processing: sharp (in-process) | imgproxy | cloudinary | imagekit
MEDIA_PROCESSOR=sharp
IMGPROXY_URL=
IMGPROXY_KEY=
IMGPROXY_SALT=
CLOUDINARY_URL=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- CDN for media ---------------------------------------------------------
# Public origin is NEXT_PUBLIC_MEDIA_CDN_URL in §1. Signing is optional.
MEDIA_CDN_SIGNING_KEY=
MEDIA_CDN_SIGNED_URL_TTL_SECONDS=3600
MEDIA_CDN_CACHE_MAX_AGE_SECONDS=31536000

# --- Photo moderation ------------------------------------------------------
# Every photograph is checked by a moderator before it appears. Optional
# automated pre-check: none | rekognition | vision
MEDIA_MODERATION_PROVIDER=none
MEDIA_MODERATION_API_KEY=

# =============================================================================
# 11. Verification sources  [RESERVED]  (plan §9.4)
# =============================================================================
# Primary match key is council + registration number. Name alone is never used.

# National Medical Register / Indian Medical Register. Lookups are manual or
# semi-automated; configure where an API or licensed bulk file exists.
NMR_LOOKUP_URL=https://nmr-nmc.abdm.gov.in/nmr/v3/
NMR_API_KEY=
NMR_BULK_FILE_PATH=
# State Medical Council lookups (per council, where an endpoint exists).
SMC_KARNATAKA_LOOKUP_URL=
SMC_TAMILNADU_LOOKUP_URL=
SMC_MAHARASHTRA_LOOKUP_URL=
SMC_DELHI_LOOKUP_URL=
SMC_TELANGANA_LOOKUP_URL=
# NMC black-listed doctors list — checked on every serious report and annually.
NMC_BLACKLIST_URL=https://www.nmc.org.in/information-desk/indian-medical-register/black-list-doctors/
# ABDM Healthcare Professionals Registry (secondary signal only).
HPR_API_BASE_URL=
HPR_CLIENT_ID=
HPR_CLIENT_SECRET=
HPR_TOKEN_URL=
# ABDM Health Facility Registry (facility identity and affiliations).
HFR_API_BASE_URL=
HFR_CLIENT_ID=
HFR_CLIENT_SECRET=
# Verification evidence retention after case close (days).
VERIFICATION_EVIDENCE_RETENTION_DAYS=1095
# Target turnaround (business days) shown to doctors.
VERIFICATION_TARGET_BUSINESS_DAYS=2

# =============================================================================
# 12. Security, bot defence, encryption  [RESERVED]
# =============================================================================

# CAPTCHA: turnstile | recaptcha | hcaptcha
CAPTCHA_PROVIDER=turnstile
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
# Score threshold for risk-scored providers.
CAPTCHA_MIN_SCORE=0.5

# Application-level encryption for private contact and evidence fields.
# [READ] 32 bytes, base64 (`openssl rand -base64 32`). Encrypts TOTP secrets at
# rest. Rotate by listing old,new. Falls back to a key derived from AUTH_SECRET.
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_PREVIOUS=
# Hashing pepper for reviewer contact identifiers (one person, one review).
CONTACT_HASH_PEPPER=

# Rate limits: requests per window per IP, for public write endpoints.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REVIEW_SUBMIT=3
RATE_LIMIT_OTP_REQUEST=5
RATE_LIMIT_ENQUIRY=5
RATE_LIMIT_REPORT=5
RATE_LIMIT_CORRECTION=5
RATE_LIMIT_SEARCH=120
# [READ] Practice phone / directions releases per signed-in account per hour.
RATE_LIMIT_CONTACT_PER_HOUR=60
# Global per-IP limit applied at the edge.
RATE_LIMIT_GLOBAL_PER_MINUTE=600

# CORS for the API tier.
CORS_ALLOWED_ORIGINS=https://thedoctorindex.in,https://www.thedoctorindex.in
# Content Security Policy report endpoint (report-only until tuned).
CSP_REPORT_URI=
CSP_REPORT_ONLY=1
# Trusted proxy hops for correct client IP behind CDN/WAF.
TRUST_PROXY_HOPS=1
# WAF / edge: cloudflare | aws | none
WAF_PROVIDER=cloudflare
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# Secrets manager: env | aws-secrets-manager | vault | doppler
SECRETS_PROVIDER=env
VAULT_ADDR=
VAULT_TOKEN=

# =============================================================================
# 13. Analytics, monitoring, logging  [RESERVED]
# =============================================================================
# No health data, review evidence or identity documents ever reach any of these.

# Product analytics: plausible | posthog | ga4 | none
ANALYTICS_PROVIDER=plausible
NEXT_PUBLIC_ANALYTICS_DOMAIN=thedoctorindex.in
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# Server-side event endpoint for the instrumentation in plan §17
# (search_started, profile_viewed, call_clicked, enquiry_submitted, …).
ANALYTICS_EVENT_ENDPOINT=
ANALYTICS_EVENT_API_KEY=
ANALYTICS_SAMPLE_RATE=1
# Cookie consent: strictly-necessary only until consent is given.
NEXT_PUBLIC_CONSENT_REQUIRED=1
NEXT_PUBLIC_CONSENT_COOKIE_NAME=tdi_consent

# Error tracking (Sentry or compatible).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Real-user performance (Core Web Vitals field data; plan §13.3 targets).
# Provider: vercel | speedcurve | datadog | custom
RUM_PROVIDER=custom
NEXT_PUBLIC_RUM_ENDPOINT=
NEXT_PUBLIC_RUM_SAMPLE_RATE=0.2

# Logs and traces (OpenTelemetry).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=thedoctorindex-web
OTEL_TRACES_SAMPLER_ARG=0.1
LOG_LEVEL=info
LOG_FORMAT=json
# Fields redacted from logs (comma-separated JSON paths).
LOG_REDACT_PATHS=req.headers.authorization,req.headers.cookie,body.otp,body.phone,body.email

# Uptime and health.
HEALTHCHECK_TOKEN=
HEALTHCHECK_PATH=/api/health
STATUS_PAGE_URL=

# Performance budgets enforced in CI (plan §13.3).
PERF_BUDGET_INITIAL_JS_KB=180
PERF_BUDGET_INITIAL_TRANSFER_KB=1024
PERF_BUDGET_LCP_MS=2500
PERF_BUDGET_INP_MS=200
PERF_BUDGET_CLS=0.10

# =============================================================================
# 14. SEO tooling  [RESERVED]
# =============================================================================

# Domain verification tokens (meta-tag method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=
# Service account for pulling Search Console data into the doctor dashboard.
GSC_SERVICE_ACCOUNT_JSON_BASE64=
GSC_PROPERTY=sc-domain:thedoctorindex.in
GSC_SYNC_CRON=0 3 * * *
# IndexNow key for pushing changed URLs to Bing and others.
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
# Sitemap generation.
SITEMAP_MAX_URLS_PER_FILE=45000
SITEMAP_CACHE_SECONDS=3600
# Crawl budget controls.
ROBOTS_CRAWL_DELAY=
# Third-party crawl monitoring (e.g. Lumar, OnCrawl, Screaming Frog cloud).
CRAWL_MONITOR_API_KEY=

# =============================================================================
# 15. Notifications and alerts  [RESERVED]
# =============================================================================

# Doctor-facing (reconfirmation prompts, verification outcomes, review notices).
NOTIFY_FROM_EMAIL=updates@thedoctorindex.in
NOTIFY_DIGEST_HOUR_LOCAL=9
NOTIFY_MAX_PER_DAY_PER_DOCTOR=3
# Push (Phase 6 apps).
PUSH_PROVIDER=
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_BASE64=
# Internal alerts (moderation backlog, SLA breach, verification queue depth).
ALERT_PROVIDER=slack
ALERT_WEBHOOK_URL=
ALERT_SLA_BREACH_CHANNEL=
ALERT_SECURITY_CHANNEL=
PAGERDUTY_ROUTING_KEY=
# Queue depth at which an alert fires.
ALERT_VERIFICATION_BACKLOG_THRESHOLD=50
ALERT_MODERATION_BACKLOG_THRESHOLD=100

# =============================================================================
# 16. Compliance, retention, legal document versions  [RESERVED]  (plan §16)
# =============================================================================

# Data Protection / grievance officer details for notices and the DPB.
DPO_NAME=
DPO_EMAIL=grievance@thedoctorindex.in
DPO_POSTAL_ADDRESS=
# Legal entity shown in Terms and Privacy.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_CIN=
LEGAL_ENTITY_REGISTERED_ADDRESS=
# Versions recorded with every consent so a change can be re-consented.
CONSENT_VERSION=2026-08-28
PRIVACY_POLICY_VERSION=2026-08-28
TERMS_VERSION=2026-08-28
REVIEW_POLICY_VERSION=2026-08-28
# Retention schedule (days). 0 = keep while the parent record exists.
RETENTION_REVIEW_EVIDENCE_DAYS=90
RETENTION_IDENTITY_DOCUMENTS_DAYS=1095
RETENTION_OTP_LOGS_DAYS=30
RETENTION_ANALYTICS_RAW_DAYS=395
RETENTION_ENQUIRY_DAYS=180
RETENTION_MODERATION_HISTORY_DAYS=0
RETENTION_AUDIT_LOG_DAYS=2555
# Data-subject request handling.
DSR_ACK_HOURS=24
DSR_RESOLUTION_DAYS=30
# Region where personal data is stored and processed.
DATA_REGION=ap-south-1
# Breach notification contacts.
BREACH_NOTIFY_EMAILS=

# =============================================================================
# 17. Moderation, review integrity, SLA targets  [RESERVED]  (plan §10)
# =============================================================================

# Internal targets shown on /policies/reviews and /policies/grievance.
SLA_SAFETY_COMPLAINT_ASSESS_HOURS=4
SLA_ORDINARY_REPORT_HOURS=48
SLA_PROFILE_CORRECTION_BUSINESS_DAYS=3
SLA_DOCTOR_VERIFICATION_BUSINESS_DAYS=2
SLA_GRIEVANCE_ACK_HOURS=24
# Automated review checks before a human sees it.
# [READ] Every review must attach proof of consultation and is published only
# after a moderator validates it. Set 0 only for a staging demo.
REVIEW_EVIDENCE_REQUIRED=1
REVIEW_MIN_TEXT_CHARS=40
REVIEW_MAX_TEXT_CHARS=2000
REVIEW_DUPLICATE_SIMILARITY_THRESHOLD=0.85
REVIEW_VELOCITY_MAX_PER_DOCTOR_PER_DAY=10
REVIEW_VELOCITY_MAX_PER_DEVICE_PER_DAY=2
# Prohibited-data detection (phone numbers, addresses, report values).
REVIEW_PII_DETECTOR=regex
REVIEW_PII_DETECTOR_API_KEY=
# Serious-allegation keywords route to the legal queue.
REVIEW_ESCALATION_KEYWORDS_PATH=
# Doctor reply limits.
REVIEW_REPLY_MAX_CHARS=800
REVIEW_REPLY_ONE_PER_REVIEW=1
# Minimum reviews before an average is displayed.
REVIEW_MIN_COUNT_TO_DISPLAY_AVERAGE=3

# =============================================================================
# 18. Payments and integrations  [RESERVED]  (plan §23, Phase 6 — never for organic rank)
# =============================================================================

# Payments for premium tools only. Provider: razorpay | stripe | cashfree
PAYMENTS_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# GST for invoicing premium subscriptions.
GSTIN=
INVOICE_PREFIX=TDI
# Appointment / calendar integrations (Phase 6).
BOOKING_PROVIDER=
BOOKING_API_KEY=
BOOKING_WEBHOOK_SECRET=
# Generic outbound webhooks (hospital partners).
WEBHOOK_SIGNING_SECRET=
WEBHOOK_TIMEOUT_MS=5000

# =============================================================================
# 19. Admin console  [RESERVED]  (plan §5.3)
# =============================================================================

# Separate origin for the console; never crawled, never public.
ADMIN_URL=https://admin.thedoctorindex.in
ADMIN_ALLOWED_EMAIL_DOMAINS=thedoctorindex.in
# CIDR allowlist; empty means no IP restriction (not recommended in production).
ADMIN_IP_ALLOWLIST=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_REQUIRE_MFA=1
# Bulk import staging (plan §15).
IMPORT_STAGING_BUCKET=tdi-import-staging
IMPORT_MAX_ROWS_PER_BATCH=5000
IMPORT_AUTO_MERGE=0
# Duplicate-candidate thresholds.
DEDUPE_NAME_SIMILARITY_THRESHOLD=0.9
DEDUPE_REQUIRE_MANUAL_MERGE=1

# =============================================================================
# 20. Cache, CDN, ISR  [RESERVED]
# =============================================================================

# Incremental regeneration intervals (seconds) once data comes from the API.
REVALIDATE_PROFILE_SECONDS=3600
REVALIDATE_LISTING_SECONDS=900
REVALIDATE_HUB_SECONDS=3600
REVALIDATE_EDITORIAL_SECONDS=86400
# CDN cache purge on approved edits.
CDN_PROVIDER=cloudflare
CDN_PURGE_API_TOKEN=
CDN_PURGE_ZONE_ID=
# Cached HTML TTFB target ≤ 500 ms; uncached p95 ≤ 1 s (plan §13.3).
CACHE_HTML_S_MAXAGE_SECONDS=300
CACHE_HTML_STALE_WHILE_REVALIDATE_SECONDS=86400

# =============================================================================
# 21. Jobs and scheduling  [RESERVED]
# =============================================================================

# Secret required by /api/cron/* endpoints (or the worker) to run scheduled jobs.
# [READ] Bearer token /api/cron/maintenance requires (Vercel Cron sends it automatically).
CRON_SECRET=
# Schedules (cron syntax, UTC).
CRON_REVERIFY_REGISTRATIONS=0 2 * * 0
CRON_RECONFIRM_PROMPTS=0 4 * * *
CRON_STALE_PROFILE_SWEEP=30 4 * * *
CRON_SITEMAP_REFRESH=0 */6 * * *
CRON_RATING_ROLLUPS=*/15 * * * *
CRON_RETENTION_PURGE=0 3 * * *
CRON_GSC_SYNC=0 3 * * *
# Timezone for reporting cutoffs.
JOBS_TIMEZONE=Asia/Kolkata

# =============================================================================
# 22. Local development, testing, CI
# =============================================================================

# [RESERVED] Docker Compose services for local Postgres/Redis/MinIO/ClamAV.
COMPOSE_PROJECT_NAME=thedoctorindex
POSTGRES_USER=tdi_app
POSTGRES_PASSWORD=password
POSTGRES_DB=thedoctorindex
POSTGRES_PORT=5432
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_PORT=9000
# Seed mode: fixture | none. This repository ships fixtures in lib/data.
SEED_MODE=fixture
# Test database and browser tests.
TEST_DATABASE_URL=postgresql://tdi_app:password@localhost:5432/thedoctorindex_test
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_BROWSERS_PATH=
# CI
CI=
# Set to 1 to skip network-dependent steps (font download, external checks).
CI_OFFLINE=
# Lighthouse CI assertions use the PERF_BUDGET_* values in §13.
LHCI_GITHUB_APP_TOKEN=
LHCI_SERVER_URL=
